# ============================================================
#  EmailSender Server — Environment Template
#  COPY this file to .env and fill in real values.
#  The .env file must NEVER be committed to git.
# ============================================================

NODE_ENV=production
PORT=8085

# JWT Secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# CORS — the URL from which the browser will access this app
# Use the machine hostname or IP. Example: http://localhost:8085
ALLOWED_ORIGIN=*

# -------------------------------------------------------
# SMTP Defaults (pre-fill the form)
# -------------------------------------------------------
SMTP_HOST=mail.ethiopianairlines.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password_here
SMTP_SECURE=false
